<Window x:Class="ShaUtils.CompareFoldersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Choices" Height="300" Width="600" MinHeight="250" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Path A -->
            <RowDefinition Height="Auto"/>
            <!-- Path B -->
            <RowDefinition Height="*"/>
            <!-- Comparison Type Selection -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Compare these two folders:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <!-- Folder A Path -->
        <TextBlock Grid.Row="1" x:Name="FolderAPathTextBlock" Text="Folder A Path" TextWrapping="Wrap" Margin="10,0,0,5" Foreground="#FF333333"/>

        <!-- Folder B Path -->
        <TextBlock Grid.Row="2" x:Name="FolderBPathTextBlock" Text="Folder B Path" TextWrapping="Wrap" Margin="10,0,0,15" Foreground="#FF333333"/>

        <!-- Comparison Type Dropdown -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5">
            <TextBlock Text="Comparison type:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <ComboBox x:Name="ComparisonTypeComboBox" Width="300" VerticalAlignment="Center">
                <ComboBoxItem IsSelected="True">File Names &amp; Count (Super Fast)</ComboBoxItem>
                <ComboBoxItem>Names, Sizes, &amp; Dates (Very Fast)</ComboBoxItem>
                <ComboBoxItem>CRC32 Checksums (Fast Content Check)</ComboBoxItem>
                <ComboBoxItem>SHA256 Hashes (Thorough, Slower)</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <!-- OK and Cancel Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="CompareButton" Content="Compare" Width="100" Padding="5" IsDefault="True" Click="CompareButton_Click" Margin="0,0,10,0"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="100" Padding="5" IsCancel="True" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
